<Window x:Class="SnapNoteStudio.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapNote Studio"
        WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="480"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="PrimaryColor">#4A90D9</Color>
        <Color x:Key="SidebarBg">#2D2D30</Color>
        <Color x:Key="SidebarHover">#3E3E42</Color>
        <Color x:Key="SidebarSelected">#007ACC</Color>
        <Color x:Key="HeaderBg">#3C3C3C</Color>
        
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBg}"/>
        
        <!-- Tool Button Style -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Color Button Style -->
        <Style x:Key="ColorButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="2"
                                BorderBrush="#555555"
                                Cursor="Hand">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E4E52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Image Button Style -->
        <Style x:Key="ImageOpButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- Toggle Action Button Style -->
        <Style x:Key="ToggleActionButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E4E52"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" MinWidth="110" MaxWidth="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="OcrSplitterColumnDef" Width="0"/>
            <ColumnDefinition x:Name="OcrPaneColumnDef" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource HeaderBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                
                <!-- Top row: Undo/Redo, Title, Save/Copy -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Reuse-this-window toggle / Undo/Redo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                        <ToggleButton x:Name="ReuseWindowToggle" Content="📌 New Here"
                                      Style="{StaticResource ToggleActionButtonStyle}"
                                      ToolTip="Show new captures in this window (capture with the usual shortcut)"
                                      Checked="ReuseWindowToggle_Checked" Unchecked="ReuseWindowToggle_Unchecked"
                                      Margin="0,0,4,0"/>
                        <ToggleButton x:Name="AutoOcrToggle" Content="🔤 Auto OCR"
                                      Style="{StaticResource ToggleActionButtonStyle}"
                                      ToolTip="Automatically run OCR whenever a new capture loads"
                                      Checked="AutoOcrToggle_Changed" Unchecked="AutoOcrToggle_Changed"
                                      Margin="0,0,4,0"/>
                        <ToggleButton x:Name="AutoTranslateToggle" Content="🌐 Auto Trans"
                                      Style="{StaticResource ToggleActionButtonStyle}"
                                      ToolTip="Automatically OCR and translate whenever a new capture loads"
                                      Checked="AutoTranslateToggle_Changed" Unchecked="AutoTranslateToggle_Changed"
                                      Margin="0,0,12,0"/>
                        <Button x:Name="UndoButton" Content="↩ Undo"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Undo (Ctrl+Z)" Click="UndoButton_Click"/>
                        <Button x:Name="RedoButton" Content="↪ Redo"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Redo (Ctrl+Y)" Click="RedoButton_Click"/>
                    </StackPanel>
                    
                    <!-- Title -->
                    <TextBlock Grid.Column="1" Text="SnapNote Studio" 
                               Foreground="#AAAAAA" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <!-- Save/Copy -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <Button x:Name="CopyButton" Content="📋 Copy" Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Copy (Ctrl+C)" Click="CopyButton_Click"/>
                        <Button x:Name="SaveButton" Content="💾 Save" Style="{StaticResource ActionButtonStyle}"
                                ToolTip="Save (Ctrl+S)" Click="SaveButton_Click"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
                
                <!-- Bottom row: Color palette and stroke width -->
                <Border Grid.Row="1" Background="#333333" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Color Palette -->
                        <TextBlock x:Name="ColorLabel" Text="Color:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="ColorRed" Background="#FF0000" GroupName="Colors" 
                                     Style="{StaticResource ColorButtonStyle}" IsChecked="True"
                                     Checked="ColorButton_Checked" Tag="#FFFF0000"/>
                        <RadioButton x:Name="ColorBlue" Background="#0066FF" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FF0066FF"/>
                        <RadioButton x:Name="ColorGreen" Background="#00AA00" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FF00AA00"/>
                        <RadioButton x:Name="ColorYellow" Background="#FFFF00" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FFFFFF00"/>
                        <RadioButton x:Name="ColorOrange" Background="#FF8800" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FFFF8800"/>
                        <RadioButton x:Name="ColorPurple" Background="#AA00FF" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FFAA00FF"/>
                        <RadioButton x:Name="ColorBlack" Background="#000000" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FF000000"/>
                        <RadioButton x:Name="ColorWhite" Background="#FFFFFF" GroupName="Colors"
                                     Style="{StaticResource ColorButtonStyle}"
                                     Checked="ColorButton_Checked" Tag="#FFFFFFFF"/>
                        
                        <!-- Separator -->
                        <Border Width="1" Background="#555555" Margin="12,2"/>
                        
                        <!-- Stroke Width Slider -->
                        <TextBlock x:Name="ThicknessLabel" Text="Size:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="StrokeWidthSlider" Width="80" Minimum="1" Maximum="10" Value="3"
                                VerticalAlignment="Center" ValueChanged="StrokeWidthSlider_ValueChanged"/>
                        <TextBlock x:Name="StrokeWidthText" Text="3" Foreground="#CCCCCC" 
                                   VerticalAlignment="Center" Margin="4,0,0,0" Width="16"/>
                        
                        <!-- Separator -->
                        <Border Width="1" Background="#555555" Margin="12,2"/>
                        
                        <!-- Opacity/Intensity Slider -->
                        <TextBlock x:Name="OpacityLabel" Text="Opacity:" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="OpacitySlider" Width="80" Minimum="0.1" Maximum="1.0" Value="1.0"
                                VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="OpacityText" Text="100%" Foreground="#CCCCCC" 
                                   VerticalAlignment="Center" Margin="4,0,0,0" Width="36"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Left Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4">
                    <!-- Drawing Tools -->
                    <TextBlock x:Name="DrawingLabel" Text="Draw" Foreground="#888888" FontSize="10" 
                               Margin="4,8,4,4" FontWeight="Bold"/>
                    
                    <WrapPanel Width="102">
                        <RadioButton x:Name="PanToolButton" Content="✋" ToolTip="Move (Space)"
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     IsChecked="True" Checked="PanTool_Checked"/>
                        <RadioButton x:Name="SelectToolButton" Content="▶" ToolTip="Select (V)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="SelectTool_Checked"/>
                        <RadioButton x:Name="ArrowToolButton" Content="➜" ToolTip="Arrow (A)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="ArrowTool_Checked"/>
                        <RadioButton x:Name="LineToolButton" Content="╱" ToolTip="Line (L)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="LineTool_Checked"/>
                        <RadioButton x:Name="RectToolButton" Content="□" ToolTip="Rectangle (R)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="RectTool_Checked"/>
                        <RadioButton x:Name="EllipseToolButton" Content="○" ToolTip="Ellipse (E)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="EllipseTool_Checked"/>
                        <RadioButton x:Name="TextToolButton" Content="T" ToolTip="Text (T)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="TextTool_Checked"/>
                        <RadioButton x:Name="StepToolButton" Content="①" ToolTip="Number (N)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="StepTool_Checked"/>
                        <RadioButton x:Name="HighlighterToolButton" Content="🖍" ToolTip="Highlighter (H)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="HighlighterTool_Checked"/>
                    </WrapPanel>
                    
                    <!-- Separator -->
                    <Border Height="1" Background="#444444" Margin="4,8"/>
                    
                    <!-- Effect Tools -->
                    <TextBlock x:Name="EffectsLabel" Text="Effects" Foreground="#888888" FontSize="10" 
                               Margin="4,4,4,4" FontWeight="Bold"/>
                    
                    <WrapPanel Width="102">
                        <RadioButton x:Name="FilledRectToolButton" Content="■" ToolTip="Fill (F)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="FilledRectTool_Checked"/>
                        <RadioButton x:Name="MosaicToolButton" Content="▦" ToolTip="Mosaic (M)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="MosaicTool_Checked"/>
                        <RadioButton x:Name="BlurToolButton" Content="◎" ToolTip="Blur (B)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="BlurTool_Checked"/>
                        <RadioButton x:Name="SpotlightToolButton" Content="💡" ToolTip="Spotlight (S)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="SpotlightTool_Checked"/>
                        <RadioButton x:Name="MagnifierToolButton" Content="🔍" ToolTip="Magnifier (G)" 
                                     GroupName="Tools" Style="{StaticResource ToolButtonStyle}"
                                     Checked="MagnifierTool_Checked"/>
                    </WrapPanel>
                    
                    <!-- Separator -->
                    <Border Height="1" Background="#444444" Margin="4,8"/>
                    
                    <!-- Image Operations -->
                    <TextBlock x:Name="ImageLabel" Text="Image" Foreground="#888888" FontSize="10" 
                               Margin="4,4,4,4" FontWeight="Bold"/>
                    
                    <WrapPanel Width="102">
                        <Button x:Name="CropButton" Content="✂Crop" ToolTip="Crop" 
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="CropButton_Click"/>
                        <Button x:Name="RotateButton" Content="↻Rotate" ToolTip="Rotate 90°" 
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="RotateButton_Click"/>
                        <Button x:Name="ResizeButton" Content="⇲Resize" ToolTip="Resize" 
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="ResizeButton_Click"/>
                        <Button x:Name="SharpenButton" Content="✦Sharp" ToolTip="Sharpen"
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="SharpenButton_Click"/>
                        <Button x:Name="OcrButton" Content="🔤OCR" ToolTip="Extract Text (OCR)"
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="OcrButton_Click"/>
                        <Button x:Name="OcrTranslateQuickButton" Content="🌐Trans" ToolTip="OCR + Translate"
                                Style="{StaticResource ImageOpButtonStyle}"
                                Click="OcrTranslateQuickButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- Main Editor Area -->
        <ScrollViewer x:Name="EditorScrollViewer"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      PreviewMouseWheel="EditorScrollViewer_PreviewMouseWheel"
                      PreviewMouseDown="EditorScrollViewer_PreviewMouseDown"
                      PreviewMouseMove="EditorScrollViewer_PreviewMouseMove"
                      PreviewMouseUp="EditorScrollViewer_PreviewMouseUp"
                      LostMouseCapture="EditorScrollViewer_LostMouseCapture">
            <Border Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                
                <Grid x:Name="EditorContainer">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="EditorZoomTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>

                    <Image x:Name="BackgroundImage" 
                           Stretch="None"
                           IsHitTestVisible="False"/>
                    
                    <Canvas x:Name="EditorCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- OCR Pane Splitter -->
        <GridSplitter x:Name="OcrPaneSplitter"
                      Grid.Row="1" Grid.Column="2"
                      Width="4" HorizontalAlignment="Stretch"
                      Background="#444444"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="Collapsed"/>

        <!-- OCR Result Pane -->
        <Border x:Name="OcrPane"
                Grid.Row="1" Grid.Column="3"
                Background="{StaticResource SidebarBgBrush}"
                Visibility="Collapsed">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OcrPaneTitle" Grid.Column="0" Text="OCR Result"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="OcrPaneCloseButton" Grid.Column="1" Content="✕"
                            Width="26" Height="26"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OcrPaneClose_Click"/>
                </Grid>

                <TextBox x:Name="OcrResultTextBox" Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#1E1E1E" Foreground="#DDDDDD"
                         BorderBrush="#555555" BorderThickness="1"
                         FontSize="13" Padding="8"
                         PreviewMouseWheel="OcrResultTextBox_PreviewMouseWheel"/>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="OcrTranslateLabel" Text="Translate to:"
                               Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="OcrTargetLanguageComboBox" Grid.Column="0"
                                  IsEditable="True" Height="28" Margin="0,0,8,0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                            <ComboBoxItem Content="Chinese (Simplified)"/>
                            <ComboBoxItem Content="Korean"/>
                            <ComboBoxItem Content="Spanish"/>
                            <ComboBoxItem Content="French"/>
                            <ComboBoxItem Content="German"/>
                        </ComboBox>
                        <Button x:Name="OcrTranslateButton" Grid.Column="1" Content="Translate"
                                Width="90" Height="28"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                Click="OcrTranslate_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="OcrCopyButton" Content="Copy"
                            Width="80" Height="28"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OcrCopy_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{StaticResource SidebarBgBrush}"
                Padding="12,6">
            <Grid>
                <TextBlock x:Name="StatusText" Text="準備完了" Foreground="#888888" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StepCountText" Text="" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
